{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IA Usage Bar",
  "version": "0.1.0",
  "identifier": "com.alberth.iausagebar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "IA Usage Bar",
        "width": 360,
        "height": 500,
        "minWidth": 320,
        "minHeight": 380,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "center": true,
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active",
          "radius": 18,
          "color": [28, 28, 30, 230]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
