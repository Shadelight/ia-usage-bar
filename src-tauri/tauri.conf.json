{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IA Usage Bar",
  "version": "0.3.6",
  "identifier": "com.alberth.iausagebar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "IA Usage",
        "width": 410,
        "height": 640,
        "minWidth": 320,
        "minHeight": 180,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/header.bmp",
        "uninstallerHeaderImage": "windows/header.bmp",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["English"],
        "customLanguageFiles": {
          "English": "./windows/English.nsh"
        }
      }
    }
  }
}
